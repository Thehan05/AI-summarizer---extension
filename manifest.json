{
    "manifest_version": 3,
    "name": "TL;DR Extension",
    "version": "1.0",
    "description": "Summarize articles and web pages with TL;DR Extension.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    }
}